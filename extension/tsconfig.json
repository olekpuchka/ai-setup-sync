{
  "compilerOptions": {
    "module": "commonjs",
    // Tracks the extension-host runtime (engines.vscode ^1.125.0 ships Node 24).
    // Keep `lib` explicit: omitting it pulls in DOM types the extension host lacks.
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
